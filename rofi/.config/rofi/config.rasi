configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "konsole";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    display-run: "   Run ";
    display-window: "     Window ";
}

@theme "/home/cinar/.local/share/rofi/themes/rounded-red-dark.rasi"
